{
  "name": "timertabata",
  "productName": "TimerTabata",
  "version": "1.0.0",
  "description": "Offline interval/Tabata timer for Windows and Linux",
  "license": "Apache-2.0",
  "author": "TimerTabata contributors <nhoray.men.gever@gmail.com>",
  "homepage": "https://github.com/NehorayM/timerTabata",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "electron scripts/make-icons.cjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "visual": "playwright test --project=visual"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-condensed": "5.3.0",
    "@material-design-icons/svg": "0.14.15",
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.7.9",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "build": {
    "appId": "io.github.nehoraym.timertabata",
    "productName": "TimerTabata",
    "copyright": "Apache-2.0",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "timertabata",
      "maintainer": "TimerTabata contributors <nhoray.men.gever@gmail.com>",
      "synopsis": "Offline interval and Tabata timer",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TimerTabata"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "desktopName": "timertabata.desktop"
}
